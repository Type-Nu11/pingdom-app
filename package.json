{
  "name": "pingdom_app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check:v2": "node scripts/check-v2-boundaries.mjs",
    "check:a11y-i18n": "node scripts/check-accessibility-i18n.mjs",
    "check:api-contract": "node scripts/check-api-contract.mjs && node scripts/check-account-api-contract.mjs",
    "generate:api-types": "openapi-typescript docs/api/mvp.openapi.json -o src/v2/shared/api/generated/mvp.ts && openapi-typescript docs/api/account.openapi.json -o src/v2/shared/api/generated/account.ts",
    "check:api-types": "node scripts/check-generated-api-types.mjs",
    "check:mock-contract": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand && npm run test:regression",
    "test:regression": "npm run test:navigation && npm run test:i18n-formatters && npm run test:v2-notifications && npm run test:v2-map && npm run test:v2-api",
    "validate:pr": "npm run typecheck && npm run test:ci",
    "test:navigation": "tsx --test src/app/navigation/__tests__/*.test.mjs",
    "test:i18n-formatters": "tsx --test src/shared/i18n/__tests__/*.test.mjs",
    "test:v2-notifications": "tsx --test src/v2/app/navigation/__tests__/*.test.mjs",
    "test:v2-map": "tsx --test src/v2/features/map/__tests__/*.test.mjs",
    "test:v2-api": "EXPO_PUBLIC_APP_ENV=development EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1/api/v1 EXPO_PUBLIC_API_MODE=mock EXPO_PUBLIC_MOCK_LATENCY_MS=0 tsx --test src/v2/shared/api/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/messaging": "^24.1.1",
    "@react-navigation/native": "^7.3.12",
    "@react-navigation/native-stack": "^7.18.4",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.0",
    "expo": "~55.0.28",
    "expo-blur": "~55.0.16",
    "expo-file-system": "~55.0.24",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-image-picker": "~55.0.22",
    "expo-location": "~55.1.12",
    "expo-notifications": "~55.0.25",
    "expo-sharing": "~55.0.22",
    "expo-status-bar": "~55.0.4",
    "i18n-js": "^4.5.3",
    "i18next": "^26.3.2",
    "react": "19.2.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.83.6",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "styled-components": "^6.4.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.20",
    "openapi-typescript": "^7.13.0",
    "react-native-svg-transformer": "^1.5.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "private": true
}
