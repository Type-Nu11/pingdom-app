+package eightbitlab.com.blurview;
+
+import android.annotation.TargetApi;
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.RenderEffect;
+import android.graphics.RenderNode;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.drawable.Drawable;
+import android.os.Build;
+import android.view.ViewTreeObserver;
+
+/** SDK 31+: blur the destination region, including sampling padding, instead of
+ * allocating a target-sized filtered layer for every small glass control. */
+public final class RegionBlurView extends BlurView {
+  private int tint;
+
+  public RegionBlurView(Context context) { super(context); }
+
+  @Override public BlurViewFacade setOverlayColor(int color) {
+    tint = color;
+    return super.setOverlayColor(color);
+  }
+
+  @Override public BlurViewFacade setupWith(BlurTarget target) {
+    BlurViewFacade original = super.setupWith(target);
+    if (Build.VERSION.SDK_INT < 31) return original;
+    BlurController fallback = blurController;
+    fallback.setBlurAutoUpdate(false);
+    blurController = new RegionController(this, target, fallback, tint);
+    return blurController;
+  }
+
+  @TargetApi(31)
+  private static final class RegionController implements BlurController {
+    // Same defaults as BlurView.setupWith(target): physical radius = radius * 4.
+    private static final float SCALE = 4f;
+    private final BlurView view;
+    private final BlurTarget target;
+    private final BlurController fallback;
+    private final RenderNode node = new RenderNode("Region blur");
+    private final int[] targetLocation = new int[2];
+    private final int[] viewLocation = new int[2];
+    private final Rect region = new Rect();
+    private final Rect renderedRegion = new Rect();
+    private final ViewTreeObserver.OnPreDrawListener listener;
+    private Drawable clearDrawable;
+    private int color;
+    private float radius = DEFAULT_BLUR_RADIUS;
+    private boolean enabled = true;
+    private boolean dirty = true;
+    private int left = Integer.MIN_VALUE;
+    private int top = Integer.MIN_VALUE;
+    private int width;
+    private int height;
+
+    RegionController(BlurView view, BlurTarget target, BlurController fallback, int color) {
+      this.view = view;
+      this.target = target;
+      this.fallback = fallback;
+      this.color = color;
+      listener = () -> {
+        if (enabled && changed()) view.invalidate();
+        return true;
+      };
+      setBlurAutoUpdate(true);
+    }
+
+    private boolean changed() {
+      target.getLocationOnScreen(targetLocation);
+      view.getLocationOnScreen(viewLocation);
+      if (!view.getLocalVisibleRect(region)) region.setEmpty();
+      return dirty || view.getWidth() != width || view.getHeight() != height
+          || !region.equals(renderedRegion)
+          || viewLocation[0] - targetLocation[0] != left
+          || viewLocation[1] - targetLocation[1] != top;
+    }
+
+    @Override public boolean draw(Canvas canvas) {
+      if (!enabled) return true;
+      if (!canvas.isHardwareAccelerated()) return fallback.draw(canvas);
+      if (view.getWidth() <= 0 || view.getHeight() <= 0) return true;
+      boolean update = changed();
+      if (region.isEmpty()) return true;
+      float physicalRadius = Math.max(0.1f, radius * SCALE);
+      // Strong blur removes fine detail already. Filter a quarter-resolution
+      // surface and scale it back, preserving the physical blur radius.
+      float downsample = physicalRadius >= 24f ? 4f : 1f;
+      int padding = (int) Math.ceil(physicalRadius * 3f);
+      if (update) {
+        left = viewLocation[0] - targetLocation[0];
+        top = viewLocation[1] - targetLocation[1];
+        width = view.getWidth();
+        height = view.getHeight();
+        renderedRegion.set(region);
+        node.setPosition(0, 0, (int) Math.ceil((region.width() + padding * 2) / downsample),
+            (int) Math.ceil((region.height() + padding * 2) / downsample));
+        Canvas recording = node.beginRecording();
+        recording.scale(1f / downsample, 1f / downsample);
+        if (clearDrawable != null) clearDrawable.draw(recording);
+        recording.translate(padding - left - region.left, padding - top - region.top);
+        recording.drawRenderNode(target.renderNode);
+        node.endRecording();
+        // Reuse the effect between frames. Content changes propagate through
+        // the referenced target RenderNode without rebuilding its entire tree.
+        node.setRenderEffect(RenderEffect.createBlurEffect(physicalRadius / downsample, physicalRadius / downsample, Shader.TileMode.CLAMP));
+        dirty = false;
+      }
+      int save = canvas.save();
+      canvas.translate(region.left - padding, region.top - padding);
+      canvas.scale(downsample, downsample);
+      canvas.drawRenderNode(node);
+      canvas.restoreToCount(save);
+      Noise.apply(canvas, view.getContext(), view.getWidth(), view.getHeight());
+      if (color != 0) canvas.drawColor(color);
+      return true;
+    }
+
+    @Override public void updateBlurViewSize() { dirty = true; view.invalidate(); }
+
+    @Override public void destroy() {
+      setBlurAutoUpdate(false);
+      fallback.destroy();
+      node.discardDisplayList();
+    }
+
+    @Override public BlurViewFacade setBlurEnabled(boolean value) {
+      enabled = value;
+      fallback.setBlurEnabled(value);
+      view.invalidate();
+      return this;
+    }
+
+    @Override public BlurViewFacade setBlurAutoUpdate(boolean value) {
+      ViewTreeObserver observer = view.getViewTreeObserver();
+      if (observer.isAlive()) {
+        observer.removeOnPreDrawListener(listener);
+        if (value) observer.addOnPreDrawListener(listener);
+      }
+      return this;
+    }
+
+    @Override public BlurViewFacade setFrameClearDrawable(Drawable value) {
+      clearDrawable = value;
+      fallback.setFrameClearDrawable(value);
+      dirty = true;
+      view.invalidate();
+      return this;
+    }
+
+    @Override public BlurViewFacade setBlurRadius(float value) {
+      if (radius != value) {
+        radius = value;
+        dirty = true;
+        view.invalidate();
+      }
+      fallback.setBlurRadius(value);
+      return this;
+    }
+
+    @Override public BlurViewFacade setOverlayColor(int value) {
+      color = value;
+      fallback.setOverlayColor(value);
+      view.invalidate();
+      return this;
+    }
+  }
+}
