@@ -0,0 +1,42 @@
+package expo.modules.speechrecognition
+
+/** 16 kHz mono PCM16: a 20 ms frame is 640 bytes. No audio is retained beyond one frame. */
+internal class PingdyVadFrames(
+    private val classify: (ByteArray) -> Boolean,
+    private val publish: (Boolean, Int) -> Unit,
+) {
+    private val frame = ByteArray(640)
+    private var filled = 0
+    private var speechFrames = 0
+    private var quietFrames = 0
+    private var speaking: Boolean? = null
+
+    fun accept(data: ByteArray, count: Int) {
+        require(count in 0..data.size)
+        var offset = 0
+        while (offset < count) {
+            val copied = minOf(frame.size - filled, count - offset)
+            data.copyInto(frame, filled, offset, offset + copied)
+            filled += copied
+            offset += copied
+            if (filled != frame.size) continue
+            filled = 0
+            if (classify(frame)) {
+                quietFrames = 0
+                speechFrames = minOf(3, speechFrames + 1)
+                if (speechFrames == 3 && speaking != true) {
+                    speaking = true
+                    publish(true, 0)
+                }
+            } else {
+                speechFrames = 0
+                quietFrames = minOf(10, quietFrames + 1)
+                if (quietFrames == 10 && speaking != false) {
+                    speaking = false
+                    // This confirmed quiet already includes 200 ms of debounce.
+                    publish(false, 200)
+                }
+            }
+        }
+    }
+}
