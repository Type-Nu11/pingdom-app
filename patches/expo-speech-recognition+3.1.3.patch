+package expo.modules.speechrecognition
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class PingdyVadFramesTest {
+    @Test fun exactFramesAcrossOddChunks() {
+        val seen = mutableListOf<ByteArray>()
+        val frames = PingdyVadFrames({ seen.add(it.copyOf()); false }, { _, _ -> })
+        val pcm = ByteArray(1280) { (it % 97).toByte() }
+        frames.accept(pcm.copyOfRange(0, 319), 319)
+        assertTrue(seen.isEmpty())
+        frames.accept(pcm.copyOfRange(319, 1280), 961)
+        assertEquals(2, seen.size)
+        assertArrayEquals(pcm.copyOfRange(0, 640), seen[0])
+        assertArrayEquals(pcm.copyOfRange(640, 1280), seen[1])
+    }
+    @Test fun shortGapsDoNotPublishQuietAndResumptionCancelsIt() {
+        var voice = true
+        val edges = mutableListOf<Pair<Boolean, Int>>()
+        val frames = PingdyVadFrames({ voice }, { active, quiet -> edges.add(active to quiet) })
+        fun feed(count: Int) = repeat(count) { frames.accept(ByteArray(640), 640) }
+        feed(2)
+        assertTrue(edges.isEmpty())
+        feed(1)
+        assertEquals(listOf(true to 0), edges)
+        voice = false; feed(9)
+        assertEquals(1, edges.size)
+        voice = true; feed(3)
+        voice = false; feed(10)
+        assertEquals(listOf(true to 0, false to 200), edges)
+        feed(100)
+        assertEquals(2, edges.size)
+        voice = true; feed(3)
+        assertEquals(true to 0, edges.last())
+    }
+    @Test fun isolatedNoiseDoesNotBecomeSpeech() {
+        var voice = false
+        val edges = mutableListOf<Boolean>()
+        val frames = PingdyVadFrames({ voice }, { active, _ -> edges.add(active) })
+        repeat(30) {
+            voice = true; frames.accept(ByteArray(640), 640)
+            voice = false; repeat(10) { frames.accept(ByteArray(640), 640) }
+        }
+        assertEquals(listOf(false), edges)
+    }
+}
