@@ -0,0 +1,19 @@
+package expo.modules.speechrecognition
+
+import com.konovalov.vad.webrtc.VadWebRTC
+import com.konovalov.vad.webrtc.config.FrameSize
+import com.konovalov.vad.webrtc.config.Mode
+import com.konovalov.vad.webrtc.config.SampleRate
+import java.io.Closeable
+
+/** Existing WebRTC GMM model. Frame hysteresis is owned by PingdyVadFrames. */
+internal class PingdyPcmVad(publish: (Boolean, Int) -> Unit) : Closeable {
+    private val model = try {
+        VadWebRTC(SampleRate.SAMPLE_RATE_16K, FrameSize.FRAME_SIZE_320, Mode.NORMAL)
+    } catch (error: LinkageError) {
+        throw IllegalStateException("PCM VAD unavailable", error)
+    }
+    private val frames = PingdyVadFrames({ model.isSpeech(it) }, publish)
+    fun accept(data: ByteArray, count: Int) = frames.accept(data, count)
+    override fun close() = model.close()
+}
