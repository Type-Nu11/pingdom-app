+package com.typenull.pingdom.consultation.application;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.typenull.pingdom.shared.config.swagger.VoiceAiOpenApiConfig;
+import io.swagger.v3.oas.models.Components;
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.Operation;
+import io.swagger.v3.oas.models.PathItem;
+import io.swagger.v3.oas.models.Paths;
+import io.swagger.v3.oas.models.responses.ApiResponses;
+import org.junit.jupiter.api.Test;
+
+class GeneralDiscoveryOpenApiTest {
+    @Test
+    void publishesGeneralDiscoveryWithoutBookingConditions() {
+        var paths = new Paths()
+                .addPathItem("/voice-ai/sessions", new PathItem().post(operation()))
+                .addPathItem("/voice-ai/sessions/{sessionId}/messages", new PathItem().post(operation()))
+                .addPathItem("/voice-ai/sessions/{sessionId}/refresh", new PathItem().post(operation()))
+                .addPathItem("/voice-ai/sessions/{sessionId}", new PathItem().delete(operation()));
+        var api = new OpenAPI().paths(paths).components(new Components());
+        new VoiceAiOpenApiConfig().voiceAiContractCustomizer().customise(api);
+        var envelope = api.getComponents().getSchemas().get("ProviderEnvelopeV1");
+        assertThat(envelope.getOneOf()).hasSize(9);
+        var general = io.swagger.v3.core.util.Json.mapper().valueToTree(envelope).path("oneOf").path(0);
+        assertThat(general.at("/properties/command/enum/0").asText()).isEqualTo("searchNearbyPlaces");
+        var args = general.at("/properties/args");
+        assertThat(args.path("required").toString()).isEqualTo("[\"useCurrentLocation\"]");
+        assertThat(args.path("properties").size()).isEqualTo(2);
+        assertThat(args.path("properties").has("touristCategory")).isTrue();
+        assertThat(args.path("properties").has("useCurrentLocation")).isTrue();
+        assertThat(args.path("additionalProperties").asBoolean(true)).isFalse();
+    }
+
+    private Operation operation() { return new Operation().responses(new ApiResponses()); }
+}
