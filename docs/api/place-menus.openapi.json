{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - tourist place menus contract",
    "version": "v0"
  },
  "x-source": {
    "location": "https://www.typenull.xyz/v3/api-docs",
    "sha256": "778478ceb6288c47c69849a5a2595255ae37d6d1fc481e5d971ec0fb0a1b7461"
  },
  "paths": {
    "/places/{placeId}/menus": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "관광객용 장소 메뉴 목록 조회",
        "description": "AVAILABLE와 SOLD_OUT 메뉴만 displayOrder 오름차순으로 반환합니다. 메뉴가 없으면 빈 목록을 반환합니다.",
        "operationId": "list_5",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "공개 메뉴 목록 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceMenuResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "장소를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "PlaceMenuResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "메뉴 설명이 없으면 null",
            "nullable": true
          },
          "priceAmount": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string",
            "description": "가격 통화. 금액은 해당 통화의 기본 단위로 저장",
            "enum": [
              "KRW",
              "USD",
              "JPY",
              "CNY",
              "EUR"
            ]
          },
          "imageUrl": {
            "type": "string",
            "description": "대표 이미지가 없으면 null",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "SOLD_OUT",
              "HIDDEN",
              "INACTIVE"
            ]
          },
          "displayOrder": {
            "type": "integer",
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
