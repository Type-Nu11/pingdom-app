{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - offers and coupons contract",
    "version": "v0"
  },
  "x-source": {
    "location": "http://54.116.166.107:8080/v3/api-docs/app",
    "sha256": "f657204996cff341149521b70e4b934207eae2cd15a6610d7b1a395b0971971c"
  },
  "paths": {
    "/coupons": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "내 관광객 Coupon 목록 조회",
        "description": "Offer 제목·혜택과 장소 정보는 Coupon 발급 시점 스냅샷을 반환하므로 Offer 종료 또는 이후 정보 변경과 무관하게 유지됩니다. 원본 정보를 복구할 수 없으면 해당 필드는 null입니다. 발급일 기간은 양 끝값을 포함합니다. status=ISSUED는 아직 만료되지 않은 쿠폰, EXPIRED는 발급 상태이면서 expiresAt이 현재 시각 이하인 쿠폰입니다. 기본 정렬은 issuedAt 내림차순, id 내림차순이며 page와 limit은 각각 최소 1, limit 최대 100으로 보정됩니다.",
        "operationId": "listMyCoupons",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "description": "쿠폰 상태. 생략하면 모든 상태를 조회합니다.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ISSUED",
                "REDEEMED",
                "EXPIRED"
              ]
            },
            "example": "ISSUED"
          },
          {
            "name": "issuedFrom",
            "in": "query",
            "description": "발급일 조회 시작 시각(포함, ISO-8601 local date-time)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-08-01T00:00:00"
          },
          {
            "name": "issuedTo",
            "in": "query",
            "description": "발급일 조회 종료 시각(포함, ISO-8601 local date-time)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-08-31T23:59:59"
          },
          {
            "name": "page",
            "in": "query",
            "description": "1부터 시작하는 페이지 번호",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            },
            "example": 1
          },
          {
            "name": "limit",
            "in": "query",
            "description": "페이지 크기. 1~100 범위로 보정됩니다.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            },
            "example": 20
          }
        ],
        "responses": {
          "200": {
            "description": "Coupon 목록 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CouponPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "발급일 기간 조건 또는 요청 파라미터 형식이 올바르지 않음",
            "content": {
              "*/*": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    }
                  ]
                },
                "examples": {
                  "COUPON_LIST_FILTER_INVALID": {
                    "description": "COUPON_LIST_FILTER_INVALID",
                    "value": {
                      "message": "쿠폰 조회 기간 조건이 올바르지 않습니다.",
                      "code": "COUPON_LIST_FILTER_INVALID"
                    }
                  },
                  "VALIDATION_FAILED": {
                    "description": "VALIDATION_FAILED",
                    "value": {
                      "message": "입력값이 올바르지 않습니다.",
                      "code": "VALIDATION_FAILED",
                      "errors": {
                        "issuedFrom": "날짜 형식이 올바르지 않습니다."
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_TOKEN": {
                    "description": "INVALID_TOKEN",
                    "value": {
                      "message": "유효하지 않은 토큰입니다.",
                      "code": "INVALID_TOKEN"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/coupons/{couponId}": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "내 관광객 Coupon 단건 조회",
        "description": "본인이 발급받은 Coupon의 현재 상태를 조회합니다. 만료 시각이 지난 미사용 Coupon은 EXPIRED로 반환하며, REDEEMED Coupon은 redeemedAt을 함께 반환합니다.",
        "operationId": "getMyCoupon",
        "parameters": [
          {
            "name": "couponId",
            "in": "path",
            "description": "Coupon ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Coupon 단건 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CouponResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_TOKEN": {
                    "description": "INVALID_TOKEN",
                    "value": {
                      "message": "유효하지 않은 토큰입니다.",
                      "code": "INVALID_TOKEN"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Coupon을 찾을 수 없거나 요청자의 Coupon이 아님",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "COUPON_NOT_FOUND": {
                    "description": "COUPON_NOT_FOUND",
                    "value": {
                      "message": "쿠폰을 찾을 수 없습니다.",
                      "code": "COUPON_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/offers": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "발급 가능한 관광객 전용 Offer 목록 조회",
        "operationId": "listIssuableOffers",
        "parameters": [
          {
            "name": "placeId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Offer 목록 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OfferPageResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/offers/{offerId}": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "발급 가능한 관광객 전용 Offer 상세 조회",
        "operationId": "getIssuableOffer",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Offer 상세 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OfferResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "발급 가능한 Offer를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/offers/{offerId}/coupons": {
      "post": {
        "tags": [
          "App"
        ],
        "summary": "관광객 Coupon 발급",
        "description": "진행 중인 여행 일정이 있는 일반 사용자에게 Offer당 한 번만 발급합니다. 발급 시 Offer 제목·혜택과 장소 정보를 Coupon에 스냅샷으로 저장합니다.",
        "operationId": "issueCoupon",
        "parameters": [
          {
            "name": "offerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Coupon 발급 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CouponResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "관광객 발급 조건 불충족",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Offer를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "중복 발급, 발급 기간 종료 또는 수량 소진",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CouponPageResponse": {
        "required": [
          "coupons",
          "hasNext",
          "limit",
          "page",
          "totalElements",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "coupons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CouponResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "CouponResponse": {
        "required": [
          "benefitDescription",
          "code",
          "expiresAt",
          "id",
          "issuedAt",
          "offerId",
          "offerTitle",
          "placeId",
          "placeName",
          "redeemedAt",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "offerId": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "offerTitle": {
            "type": "string",
            "nullable": true,
            "example": "관광객 웰컴 음료"
          },
          "benefitDescription": {
            "type": "string",
            "nullable": true,
            "example": "음료 1잔 무료"
          },
          "placeId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "example": 1
          },
          "placeName": {
            "type": "string",
            "nullable": true,
            "example": "핑덤 카페"
          },
          "code": {
            "type": "string",
            "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
          },
          "status": {
            "type": "string",
            "enum": [
              "ISSUED",
              "REDEEMED",
              "EXPIRED"
            ]
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "redeemedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "OfferPageResponse": {
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "OfferResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "placeId": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "title": {
            "type": "string",
            "example": "관광객 웰컴 음료"
          },
          "description": {
            "type": "string"
          },
          "benefitDescription": {
            "type": "string",
            "example": "음료 1잔 무료"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CLOSED"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalQuantity": {
            "type": "integer",
            "description": "LIMITED 재고의 총 발급 수량. UNLIMITED이면 null",
            "format": "int32",
            "nullable": true
          },
          "issuedQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "remainingQuantity": {
            "type": "integer",
            "description": "남은 발급 수량. UNLIMITED이면 null",
            "format": "int32",
            "nullable": true
          },
          "couponValidityDays": {
            "type": "integer",
            "format": "int32"
          },
          "eligibilityPolicy": {
            "type": "string",
            "enum": [
              "ACTIVE_TRAVEL_SCHEDULE",
              "PUBLIC"
            ]
          },
          "inventoryPolicy": {
            "type": "string",
            "enum": [
              "LIMITED",
              "UNLIMITED"
            ]
          },
          "expiryPolicy": {
            "type": "string",
            "enum": [
              "ISSUE_PLUS_DAYS_CAPPED_BY_OFFER_END",
              "ISSUE_PLUS_DAYS",
              "OFFER_END"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ValidationErrorResponse": {
        "required": [
          "code",
          "errors",
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "필드 검증 오류 응답"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
