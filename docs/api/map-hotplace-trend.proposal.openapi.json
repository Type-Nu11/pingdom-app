{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - map hotplace/trend ranking contract proposal",
    "description": "이슈 #190 확정을 위한 프론트엔드 제안 계약이다. 서버 확정 전까지 구현 기준으로 사용하지 않는다.",
    "version": "v0-proposal"
  },
  "servers": [
    {
      "url": "http://54.116.166.107:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/map/place-rankings": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "지도 장소 랭킹 조회(우리 지역 핫플 / 전국 트렌드)",
        "description": "지도 하단 시트의 우리 지역 핫플(scope=LOCAL)과 전국 트렌드(scope=NATIONAL) 목록을 조회한다.\n- 정렬은 score DESC, 동점은 placeId ASC로 tie-break한다.\n- 빈 결과는 200과 빈 배열, totalCount 0으로 응답한다.\n- scope=LOCAL에서 반경 내 결과가 minimumResultCount 미만이면 서버가 반경을 확장하고 appliedRadiusKm과 radiusExpanded로 알린다.\n- LOCAL과 NATIONAL은 서로 독립 집계이며 동일 장소가 양쪽에 나타날 수 있다. 클라이언트는 중복을 제거하지 않는다.\n- 비로그인 호출을 허용한다. 로그인 시에만 bookmarked에 사용자 값을 채우고, 비로그인에서는 null을 보낸다.\n- 랭킹 산정 자체는 개인화하지 않는다.",
        "operationId": "getMapPlaceRankings",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "description": "랭킹 범위. LOCAL은 우리 지역 핫플, NATIONAL은 전국 트렌드.",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "LOCAL",
                "NATIONAL"
              ]
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "description": "현재 위도. scope=LOCAL에서 필수, scope=NATIONAL에서는 무시한다.",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "description": "현재 경도. scope=LOCAL에서 필수, scope=NATIONAL에서는 무시한다.",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "description": "우리 지역 반경(km). scope=LOCAL에서만 사용하며 기본 5.0, 최대 50.0.",
            "required": false,
            "schema": {
              "type": "number",
              "format": "double",
              "default": 5.0
            }
          },
          {
            "name": "period",
            "in": "query",
            "description": "집계 기간. 기본 WEEK.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "DAY",
                "WEEK",
                "MONTH"
              ],
              "default": "WEEK"
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "장소 카테고리 필터. 서버가 정의한 category 값과 동일해야 한다.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "페이지 번호. 1 이상으로 보정한다.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "페이지 크기. 1~50 범위로 보정한다. collapsed 목록은 5, expanded 목록은 20을 사용한다.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceRankingResponse"
                }
              }
            }
          },
          "400": {
            "description": "scope=LOCAL에서 좌표 누락, radiusKm 범위 초과, 알 수 없는 period 또는 category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PlaceRankingResponse": {
        "type": "object",
        "required": [
          "scope",
          "period",
          "periodStart",
          "periodEnd",
          "criteria",
          "generatedAt",
          "items",
          "page",
          "limit",
          "totalCount",
          "totalPages",
          "hasNext"
        ],
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "LOCAL",
              "NATIONAL"
            ],
            "description": "요청에 적용된 랭킹 범위"
          },
          "period": {
            "type": "string",
            "enum": [
              "DAY",
              "WEEK",
              "MONTH"
            ],
            "description": "적용된 집계 기간"
          },
          "periodStart": {
            "type": "string",
            "format": "date-time",
            "description": "집계 시작 시각(UTC)"
          },
          "periodEnd": {
            "type": "string",
            "format": "date-time",
            "description": "집계 종료 시각(UTC)"
          },
          "criteria": {
            "type": "string",
            "enum": [
              "POST_LIKE_COUNT",
              "POST_COUNT",
              "CHECK_IN_COUNT",
              "COMPOSITE"
            ],
            "description": "score 산정 기준. 값이 바뀌면 FE 문구도 함께 갱신한다."
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "랭킹 스냅샷 생성 시각(UTC). 캐시 판단에 사용한다."
          },
          "appliedRadiusKm": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "실제 적용된 반경(km). scope=NATIONAL이면 null."
          },
          "requestedRadiusKm": {
            "type": "number",
            "format": "double",
            "nullable": true,
            "description": "요청된 반경(km). scope=NATIONAL이면 null."
          },
          "radiusExpanded": {
            "type": "boolean",
            "description": "결과 부족으로 서버가 반경을 확장했는지 여부. scope=NATIONAL이면 false."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceRankingItem"
            },
            "description": "랭킹 목록. 빈 결과는 빈 배열."
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "PlaceRankingItem": {
        "type": "object",
        "required": [
          "rank",
          "placeId",
          "placeName",
          "score",
          "latitude",
          "longitude",
          "imageSource"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "format": "int32",
            "description": "1부터 시작하는 순위. page를 넘어가도 전체 기준으로 연속한다."
          },
          "placeId": {
            "type": "integer",
            "format": "int64",
            "description": "장소 ID. 장소 상세 이동에 사용한다."
          },
          "placeName": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "distanceMeters": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "scope=LOCAL에서만 값을 채우고 NATIONAL이면 null."
          },
          "score": {
            "type": "number",
            "format": "double",
            "description": "criteria에 따른 랭킹 점수"
          },
          "likeCount": {
            "type": "integer",
            "format": "int64",
            "description": "기간 내 좋아요 수"
          },
          "postCount": {
            "type": "integer",
            "format": "int64",
            "description": "기간 내 게시물 수"
          },
          "imageUrl": {
            "type": "string",
            "nullable": true,
            "description": "카드 이미지 URL. 없으면 null."
          },
          "thumbnailUrl": {
            "type": "string",
            "nullable": true,
            "description": "카드 썸네일 URL. 없으면 null."
          },
          "imageSource": {
            "type": "string",
            "enum": [
              "POST",
              "PLACE_EXPLORATION_MEDIA",
              "NONE"
            ],
            "description": "이미지 출처. NONE이면 imageUrl과 thumbnailUrl은 null."
          },
          "representativePostId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "imageSource=POST일 때 이미지의 원본 게시물 ID."
          },
          "representativeMediaId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "imageSource=PLACE_EXPLORATION_MEDIA일 때 미디어 ID."
          },
          "registrantUsername": {
            "type": "string",
            "nullable": true,
            "description": "카드에 노출하는 등록자 아이디. 없으면 null."
          },
          "bookmarked": {
            "type": "boolean",
            "nullable": true,
            "description": "로그인 사용자의 북마크 여부. 비로그인은 null."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "에러 응답. 배포 spec의 ErrorResponse와 동일하게 유지한다.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "scope=LOCAL 요청에는 latitude와 longitude가 필요합니다."
          },
          "code": {
            "type": "string",
            "nullable": true,
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "example": "MAP_RANKING_LOCATION_REQUIRED"
          }
        }
      }
    }
  }
}
