{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - visit verification contract",
    "version": "v0"
  },
  "x-source": {
    "checkedAt": "2026-09-02T01:57:43.447Z",
    "location": "https://www.typenull.xyz/v3/api-docs",
    "sha256": "abb25dbf179a2d9d6d21026fe53d34c617cc6f2c955a0f942235f8e6663bbc33"
  },
  "paths": {
    "/visit-verification-sessions": {
      "post": {
        "tags": [
          "App"
        ],
        "summary": "체류 기반 방문 인증 시작",
        "description": "장소 반경 안의 첫 위치 관측으로 인증 세션을 시작합니다. 앱은 nextObservationRecommendedAt 이전에 다음 위치를 제출해야 하며, 원본 좌표는 저장하지 않습니다.",
        "operationId": "start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitVerificationStartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "인증 세션 시작 또는 진행 중·완료 세션 재반환",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VisitVerificationSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "관측 시각 또는 GPS 정확도 검증 실패",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "활성 관광객 계정이 아님",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "인증 가능한 장소를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "동일 장소의 진행 중인 인증 세션이 동시에 생성됨",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "장소 인증 허용 반경 밖",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/visit-verification-sessions/{sessionId}/observations": {
      "post": {
        "tags": [
          "App"
        ],
        "summary": "체류 인증 위치 관측 제출",
        "description": "서버 수신 시각과 연속 관측 간격으로 체류 시간을 계산합니다. 반경 이탈은 PROXIMITY_LOST, 관측 공백 또는 세션 기한 초과는 EXPIRED로 반환됩니다.",
        "operationId": "submitObservation",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisitVerificationObservationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "진행 상태 또는 완료 상태",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VisitVerificationSessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "관측 시각 또는 GPS 정확도 검증 실패",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "활성 관광객 계정이 아님",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "본인 소유 인증 세션 또는 장소를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "일일 완료 방문 인증이 이미 존재함",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/visit-verification-sessions/{sessionId}": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "내 체류 기반 방문 인증 상태 조회",
        "operationId": "get",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "401": {
            "description": "인증되지 않은 요청",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "활성 관광객 계정이 아님",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "본인 소유 인증 세션을 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "ValidationErrorResponse": {
        "required": [
          "code",
          "errors",
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "필드 검증 오류 응답"
      },
      "VisitVerificationObservationRequest": {
        "required": [
          "accuracyMeters",
          "latitude",
          "longitude",
          "observedAt"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "maximum": 90,
            "exclusiveMaximum": false,
            "minimum": -90,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "exclusiveMaximum": false,
            "minimum": -180,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "accuracyMeters": {
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VisitVerificationSessionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "touristUserId": {
            "type": "integer",
            "format": "int64"
          },
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "STARTED",
              "IN_PROGRESS",
              "PROXIMITY_LOST",
              "COMPLETED",
              "EXPIRED",
              "REJECTED"
            ]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "requiredRadiusMeters": {
            "type": "number",
            "format": "double"
          },
          "requiredDwellSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "latestDistanceMeters": {
            "type": "number",
            "format": "double"
          },
          "verifiedDwellSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "nextObservationRecommendedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "remainingSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "completedCheckInId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "reviewEligible": {
            "type": "boolean"
          }
        }
      },
      "VisitVerificationStartRequest": {
        "required": [
          "accuracyMeters",
          "latitude",
          "longitude",
          "observedAt",
          "placeId"
        ],
        "type": "object",
        "properties": {
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "latitude": {
            "maximum": 90,
            "exclusiveMaximum": false,
            "minimum": -90,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "maximum": 180,
            "exclusiveMaximum": false,
            "minimum": -180,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "accuracyMeters": {
            "minimum": 0,
            "exclusiveMinimum": false,
            "type": "number",
            "format": "double"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
