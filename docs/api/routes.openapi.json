{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - routes contract",
    "version": "v0"
  },
  "x-source": {
    "location": "https://www.typenull.xyz/v3/api-docs/app",
    "sha256": "b675a7582c15bf84d9a0d1fdfff61875eef0beec3de4a91dbd94090c95f1d85d"
  },
  "paths": {
    "/routes": {
      "post": {
        "tags": [
          "장소 탐색"
        ],
        "summary": "자동차 추천 경로 조회",
        "description": "WGS84 출발·도착 좌표로 NAVER Directions 5 traoptimal 경로 1개를 조회합니다. JWT 인증 필수이며 공급자 키는 서버에서 관리합니다. 경유지·미래 출발 시각·복수 경로·도보·대중교통·자전거는 지원하지 않습니다. 거리 m, 소요시간 초(밀리초 올림), 전체 경로 좌표를 반환하며 저장·캐시·자동 재시도를 하지 않습니다. 기본 사용자당 10회/분, IP당 100회/분이며 설정에 따라 달라질 수 있습니다.",
        "operationId": "findRoute",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              },
              "example": {
                "origin": {
                  "latitude": 37.5665,
                  "longitude": 126.978
                },
                "destination": {
                  "latitude": 37.4979,
                  "longitude": 127.0276
                },
                "mode": "car"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "실제 도로 형상 경로",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_ROUTE_REQUEST: 누락·문자열·비유한 좌표, 범위 오류, 동일 좌표, 알 수 없는 mode",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "기존 JWT 인증 오류",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "기존 접근 권한 오류",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "UNSUPPORTED_ROUTE_MODE 또는 ROUTE_NOT_FOUND",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "unsupported": {
                    "description": "unsupported",
                    "value": {
                      "message": "지원하지 않는 이동수단입니다.",
                      "code": "UNSUPPORTED_ROUTE_MODE"
                    }
                  },
                  "notFound": {
                    "description": "notFound",
                    "value": {
                      "message": "자동차 경로를 찾을 수 없습니다.",
                      "code": "ROUTE_NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "ROUTE_RATE_LIMITED: 사용자/IP 제한 초과",
            "headers": {
              "Retry-After": {
                "description": "두 제한 구간 중 긴 시간(초), 안전한 재시도 대기 상한",
                "style": "simple",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "ROUTE_PROVIDER_UNAVAILABLE: 비활성·미설정·공급자 인증/쿼터/장애/비정상 응답. 호출 제한 저장소 장애는 기존 RATE_LIMIT_UNAVAILABLE",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "ROUTE_PROVIDER_TIMEOUT",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "RouteCoordinate": {
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "maximum": 90,
            "minimum": -90,
            "type": "number",
            "description": "WGS84 위도, JSON 숫자",
            "format": "double",
            "example": 37.5665
          },
          "longitude": {
            "maximum": 180,
            "minimum": -180,
            "type": "number",
            "description": "WGS84 경도, JSON 숫자",
            "format": "double",
            "example": 126.978
          }
        }
      },
      "RouteRequest": {
        "required": [
          "destination",
          "mode",
          "origin"
        ],
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RouteCoordinate"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteCoordinate"
          },
          "mode": {
            "type": "string",
            "description": "car만 지원. walk/transit/bike는 422, 그 밖의 값은 400",
            "example": "car"
          }
        },
        "description": "현재 조회 시점의 자동차 추천 경로 요청. 동일 출발·도착 좌표는 허용하지 않습니다."
      },
      "RouteResponse": {
        "required": [
          "distanceMeters",
          "durationSeconds",
          "mode",
          "provider"
        ],
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "example": "car",
            "enum": [
              "car"
            ]
          },
          "provider": {
            "type": "string",
            "example": "naver",
            "enum": [
              "naver"
            ]
          },
          "distanceMeters": {
            "minimum": 0,
            "type": "integer",
            "description": "공급자가 계산한 총거리(m)",
            "format": "int64",
            "example": 12500
          },
          "durationSeconds": {
            "minimum": 0,
            "type": "integer",
            "description": "예상 소요시간(초), 공급자 밀리초를 올림하여 변환",
            "format": "int64",
            "example": 1800
          },
          "path": {
            "minItems": 2,
            "type": "array",
            "description": "출발→도착 순서의 도로 형상 전체. 직선 대체·끝점 덮어쓰기를 하지 않습니다.",
            "items": {
              "$ref": "#/components/schemas/RouteCoordinate"
            }
          }
        },
        "description": "NAVER traoptimal 첫 번째 실제 자동차 경로. 입력 좌표와 도로 위 시작·끝 좌표는 다를 수 있습니다."
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
