{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - Scout profile contract",
    "version": "v0"
  },
  "x-source": {
    "location": "http://34.64.51.29/v3/api-docs",
    "sha256": "751317d4d702e38f22b4d861a4db22738ebc224f0f82c9c50a4daab3c378aa5d"
  },
  "paths": {
    "/users/me/scout-profile": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "내 Scout 프로필 및 활동 자격 조회",
        "description": "Scout 프로필을 아직 신청하지 않은 사용자는 404 SCOUT_PROFILE_NOT_FOUND를 받습니다.",
        "operationId": "get",
        "responses": {
          "200": {
            "description": "Scout 프로필 및 활동 자격 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ScoutProfileResponse"
                }
              }
            }
          },
          "404": {
            "description": "Scout 프로필을 찾을 수 없음 (SCOUT_PROFILE_NOT_FOUND)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SCOUT_PROFILE_NOT_FOUND": {
                    "description": "SCOUT_PROFILE_NOT_FOUND",
                    "value": {
                      "message": "Scout 프로필을 찾을 수 없습니다.",
                      "code": "SCOUT_PROFILE_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "App"
        ],
        "summary": "내 Scout 프로필 수정",
        "description": "활성 일반 사용자이며 프로필 상태가 PENDING 또는 ACTIVE일 때만 수정할 수 있습니다.\nSUSPENDED 또는 REVOKED 프로필은 409 INVALID_SCOUT_PROFILE_STATE를 반환합니다.\n활동 자격 상태(PENDING, ELIGIBLE, SUSPENDED, EXPIRED, REVOKED)는 프로필 수정 가능 여부를\n변경하지 않으며 Scout 활동 가능 여부를 판단하는 데 사용합니다.\n",
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoutProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Scout 프로필 수정 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ScoutProfileResponse"
                }
              }
            }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아님 (SCOUT_PROFILE_ACCOUNT_REQUIRED)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SCOUT_PROFILE_ACCOUNT_REQUIRED": {
                    "description": "SCOUT_PROFILE_ACCOUNT_REQUIRED",
                    "value": {
                      "message": "활성 일반 사용자만 Scout 프로필을 신청할 수 있습니다.",
                      "code": "SCOUT_PROFILE_ACCOUNT_REQUIRED"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Scout 프로필을 찾을 수 없음 (SCOUT_PROFILE_NOT_FOUND)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SCOUT_PROFILE_NOT_FOUND": {
                    "description": "SCOUT_PROFILE_NOT_FOUND",
                    "value": {
                      "message": "Scout 프로필을 찾을 수 없습니다.",
                      "code": "SCOUT_PROFILE_NOT_FOUND"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "현재 프로필 상태에서 수정 불가 (INVALID_SCOUT_PROFILE_STATE)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_SCOUT_PROFILE_STATE": {
                    "description": "INVALID_SCOUT_PROFILE_STATE",
                    "value": {
                      "message": "현재 Scout 프로필 상태에서는 요청을 처리할 수 없습니다.",
                      "code": "INVALID_SCOUT_PROFILE_STATE"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "tags": [
          "App"
        ],
        "summary": "Scout 프로필 신청",
        "description": "활성 일반 사용자만 Scout 프로필을 신청할 수 있습니다.\nPENDING, ACTIVE, SUSPENDED, REVOKED를 포함해 기존 Scout 프로필이 하나라도 있으면\n재신청할 수 없습니다.\n",
        "operationId": "apply",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoutProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Scout 프로필 신청 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ScoutProfileResponse"
                }
              }
            }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아님 (SCOUT_PROFILE_ACCOUNT_REQUIRED)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SCOUT_PROFILE_ACCOUNT_REQUIRED": {
                    "description": "SCOUT_PROFILE_ACCOUNT_REQUIRED",
                    "value": {
                      "message": "활성 일반 사용자만 Scout 프로필을 신청할 수 있습니다.",
                      "code": "SCOUT_PROFILE_ACCOUNT_REQUIRED"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "이미 존재하는 Scout 프로필 (SCOUT_PROFILE_ALREADY_EXISTS)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "SCOUT_PROFILE_ALREADY_EXISTS": {
                    "description": "SCOUT_PROFILE_ALREADY_EXISTS",
                    "value": {
                      "message": "Scout 프로필이 이미 존재합니다.",
                      "code": "SCOUT_PROFILE_ALREADY_EXISTS"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "ScoutProfileRequest": {
        "required": [
          "displayName"
        ],
        "type": "object",
        "properties": {
          "displayName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "introduction": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ScoutProfileResponse": {
        "required": [
          "activityEligibilityStatus",
          "createdAt",
          "displayName",
          "eligibilityReviewedAt",
          "eligibilityReviewedByAdminUserId",
          "eligibilityStatusReason",
          "eligibleFrom",
          "eligibleUntil",
          "introduction",
          "profileReviewedAt",
          "profileReviewedByAdminUserId",
          "profileStatus",
          "profileStatusReason",
          "updatedAt",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "displayName": {
            "type": "string"
          },
          "introduction": {
            "type": "string",
            "nullable": true
          },
          "profileStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "ACTIVE",
              "SUSPENDED",
              "REVOKED"
            ]
          },
          "profileReviewedByAdminUserId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "profileReviewedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "profileStatusReason": {
            "type": "string",
            "nullable": true
          },
          "activityEligibilityStatus": {
            "type": "string",
            "enum": [
              "PENDING",
              "ELIGIBLE",
              "SUSPENDED",
              "EXPIRED",
              "REVOKED"
            ]
          },
          "eligibleFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "eligibleUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "eligibilityReviewedByAdminUserId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "eligibilityReviewedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "eligibilityStatusReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Scout 프로필 및 활동 자격 응답"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
