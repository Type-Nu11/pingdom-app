                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "PAYMENT_NOT_FOUND": {
                    "description": "PAYMENT_NOT_FOUND",
                    "value": {
                      "message": "결제 거래를 찾을 수 없습니다.",
