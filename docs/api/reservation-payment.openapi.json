    "/reservations/{reservationId}": {
      "get": {
        "tags": [
          "App"
        ],
        "summary": "내 예약 상세 조회",
        "description": "활성 일반 사용자는 본인 예약만 조회할 수 있습니다.\n아직 확정되지 않은 예약의 confirmedAt과 취소되지 않은 예약의 canceledAt은 null입니다.\n",
        "operationId": "getMyReservation",
        "parameters": [
          {
            "name": "reservationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "내 예약 상세 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 토큰",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "INVALID_TOKEN": {
                    "description": "INVALID_TOKEN",
                    "value": {
                      "message": "유효하지 않은 토큰입니다.",
                      "code": "INVALID_TOKEN"
                    }
                  },
                  "EXPIRED_TOKEN": {
                    "description": "EXPIRED_TOKEN",
                    "value": {
                      "message": "만료된 토큰입니다.",
                      "code": "EXPIRED_TOKEN"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아니거나 다른 사용자의 예약",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "TOURIST_ACCOUNT_REQUIRED": {
                    "description": "TOURIST_ACCOUNT_REQUIRED",
                    "value": {
                      "message": "일반 사용자 계정만 예약할 수 있습니다.",
                      "code": "TOURIST_ACCOUNT_REQUIRED"
                    }
                  },
                  "RESERVATION_FORBIDDEN": {
                    "description": "RESERVATION_FORBIDDEN",
                    "value": {
                      "message": "이 예약을 처리할 권한이 없습니다.",
                      "code": "RESERVATION_FORBIDDEN"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "예약을 찾을 수 없음 (RESERVATION_NOT_FOUND)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "RESERVATION_NOT_FOUND": {
                    "description": "RESERVATION_NOT_FOUND",
                    "value": {
                      "message": "예약을 찾을 수 없습니다.",
                      "code": "RESERVATION_NOT_FOUND"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/reservations/{reservationId}/cancel": {
      "post": {
        "tags": [
          "App"
        ],
        "summary": "내 예약 취소",
        "operationId": "cancelMyReservation",
        "parameters": [
          {
            "name": "reservationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
