  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "required": [
          "endsAt",
          "id",
          "placeId",
          "productId",
          "productName",
          "productType",
          "remainingCapacity",
          "startsAt",
          "status",
          "totalCapacity"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 77
          },
          "placeId": {
            "type": "integer",
            "format": "int64",
            "example": 70069
          },
          "productId": {
            "type": "integer",
            "description": "GENERAL은 null이며 TICKET/CLASS는 상품 ID입니다.",
            "format": "int64",
            "nullable": true,
            "example": 12
          },
          "productType": {
            "type": "string",
            "description": "예약 대상 유형",
            "example": "TICKET",
            "enum": [
              "GENERAL",
              "TICKET",
              "CLASS"
            ]
          },
          "productName": {
            "type": "string",
            "description": "GENERAL은 null이며 TICKET/CLASS는 상품명입니다.",
            "nullable": true,
            "example": "이월드 오후 입장권"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalCapacity": {
            "type": "integer",
            "format": "int32",
            "example": 100
          },
          "remainingCapacity": {
            "type": "integer",
            "format": "int32",
            "example": 42
          },
          "status": {
            "type": "string",
            "example": "ACTIVE",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        },
        "description": "예약 가능 시간 응답"
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "PaymentPageResponse": {
        "required": [
          "hasNext",
          "limit",
          "page",
          "payments",
          "totalElements",
          "totalPages"
        ],
        "type": "object",
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        },
        "description": "관광객 결제 목록 페이지 응답"
      },
      "PaymentResponse": {
        "required": [
          "amountMinor",
          "createdAt",
          "currency",
          "failedAt",
          "failureCode",
          "id",
          "paidAt",
          "provider",
          "providerPaymentId",
          "refundedAt",
          "reservationId",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "reservationId": {
            "type": "integer",
            "format": "int64"
          },
          "provider": {
            "type": "string"
          },
          "providerPaymentId": {
            "type": "string",
            "description": "결제가 PAID 상태가 되기 전에는 null입니다.",
            "nullable": true
          },
          "amountMinor": {
            "type": "integer",
            "description": "결제가 성공하기 전에는 null입니다.",
            "format": "int64",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "description": "결제가 성공하기 전에는 null입니다.",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "PROCESSING",
              "PAID",
              "REFUND_PROCESSING",
              "FAILED",
              "REFUNDED"
            ]
          },
          "failureCode": {
            "type": "string",
            "description": "결제가 FAILED 상태일 때만 제공됩니다.",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": "string",
            "description": "결제가 PAID, REFUND_PROCESSING 또는 REFUNDED 상태가 되기 전에는 null입니다.",
            "format": "date-time",
            "nullable": true
          },
          "failedAt": {
            "type": "string",
            "description": "결제가 FAILED 상태일 때만 제공됩니다.",
            "format": "date-time",
            "nullable": true
          },
          "refundedAt": {
            "type": "string",
            "description": "결제가 REFUNDED 상태가 되기 전에는 null입니다.",
            "format": "date-time",
            "nullable": true
          }
        },
        "description": "관광객 결제 응답"
      },
      "ReservationCreateRequest": {
        "required": [
          "availabilityId",
          "bookerName",
          "bookerPhone",
          "idempotencyKey"
        ],
        "type": "object",
        "properties": {
          "availabilityId": {
            "type": "integer",
            "format": "int64"
          },
          "idempotencyKey": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "quantity": {
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "bookerName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "bookerPhone": {
            "maxLength": 30,
            "minLength": 0,
            "pattern": "^[0-9+()\\- ]+$",
            "type": "string"
          },
          "requestNote": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "ReservationPageResponse": {
        "type": "object",
        "properties": {
          "reservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "ReservationResponse": {
        "required": [
          "availabilityId",
          "bookerName",
          "bookerPhone",
          "canceledAt",
          "confirmedAt",
          "createdAt",
          "id",
          "productId",
          "productType",
          "quantity",
          "requestNote",
          "reservationEndsAt",
          "reservationStartsAt",
          "status",
          "touristUserId",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "touristUserId": {
            "type": "integer",
            "format": "int64"
          },
          "availabilityId": {
            "type": "integer",
            "format": "int64"
          },
          "productId": {
            "type": "integer",
            "description": "상품 스냅샷이 없는 예약에서는 null입니다.",
            "format": "int64",
            "nullable": true
          },
          "productType": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TICKET",
              "CLASS"
            ]
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "reservationStartsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reservationEndsAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "bookerName": {
            "type": "string",
            "nullable": true
          },
          "bookerPhone": {
            "type": "string",
            "nullable": true
          },
          "requestNote": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "REJECTED",
              "CANCELED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "confirmedAt": {
            "type": "string",
            "description": "예약이 CONFIRMED 상태가 되기 전에는 null입니다.",
            "format": "date-time",
            "nullable": true
          },
          "reviewedBy": {
            "type": "integer",
            "format": "int64"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewReason": {
            "type": "string"
          },
          "rejectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "canceledAt": {
            "type": "string",
            "description": "예약이 CANCELED 상태가 되기 전에는 null입니다.",
            "format": "date-time",
            "nullable": true
          },
          "canceledBy": {
            "type": "integer",
            "format": "int64"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "관광객 예약 응답"
      },
      "ValidationErrorResponse": {
        "required": [
          "code",
          "errors",
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "필드 검증 오류 응답"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
