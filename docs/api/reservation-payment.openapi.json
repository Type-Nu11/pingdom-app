{
  "openapi": "3.0.1",
  "info": {
    "title": "PingDom reservation and tourist payment contract",
    "version": "2026-08-25",
    "x-source-url": "http://34.64.51.29/v3/api-docs"
  },
  "paths": {
    "/reservations/{reservationId}": {
      "get": {
        "operationId": "get_5",
        "parameters": [
          {
            "name": "reservationId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "내 예약 상세 조회 성공",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ReservationResponse" } } }
          },
          "401": {
            "description": "유효하지 않거나 만료된 토큰",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아니거나 다른 사용자의 예약",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "예약을 찾을 수 없음",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/payments": {
      "get": {
        "operationId": "list_7",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "minimum": 1, "maximum": 100, "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "내 결제 목록 조회 성공",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/PaymentPageResponse" } } }
          },
          "400": {
            "description": "페이지 요청 값 검증 실패",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ValidationErrorResponse" } } }
          },
          "401": {
            "description": "유효하지 않거나 만료된 토큰",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아님",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/payments/{paymentId}": {
      "get": {
        "operationId": "get_7",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "내 결제 상세 조회 성공",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/PaymentResponse" } } }
          },
          "401": {
            "description": "유효하지 않거나 만료된 토큰",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "활성 일반 사용자 계정이 아니거나 다른 사용자의 결제",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "결제 거래를 찾을 수 없음",
            "content": { "*/*": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReservationResponse": {
        "description": "관광객 예약 응답",
        "type": "object",
        "required": ["availabilityId", "canceledAt", "confirmedAt", "createdAt", "id", "productId", "productType", "quantity", "status", "touristUserId", "updatedAt"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "touristUserId": { "type": "integer", "format": "int64" },
          "availabilityId": { "type": "integer", "format": "int64" },
          "productId": { "type": "integer", "format": "int64", "nullable": true },
          "productType": { "type": "string", "enum": ["GENERAL", "TICKET", "CLASS"] },
          "quantity": { "type": "integer", "format": "int32" },
          "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "CANCELED"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "confirmedAt": { "type": "string", "format": "date-time", "nullable": true },
          "canceledAt": { "type": "string", "format": "date-time", "nullable": true },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentResponse": {
        "description": "관광객 결제 응답",
        "type": "object",
        "required": ["amountMinor", "createdAt", "currency", "failedAt", "failureCode", "id", "paidAt", "provider", "providerPaymentId", "refundedAt", "reservationId", "status"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "reservationId": { "type": "integer", "format": "int64" },
          "provider": { "type": "string" },
          "providerPaymentId": { "type": "string", "nullable": true },
          "amountMinor": { "type": "integer", "format": "int64", "nullable": true },
          "currency": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["PROCESSING", "PAID", "REFUND_PROCESSING", "FAILED", "REFUNDED"] },
          "failureCode": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "paidAt": { "type": "string", "format": "date-time", "nullable": true },
          "failedAt": { "type": "string", "format": "date-time", "nullable": true },
          "refundedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PaymentPageResponse": {
        "description": "관광객 결제 목록 페이지 응답",
        "type": "object",
        "required": ["hasNext", "limit", "page", "payments", "totalElements", "totalPages"],
        "properties": {
          "payments": { "type": "array", "items": { "$ref": "#/components/schemas/PaymentResponse" } },
          "page": { "type": "integer", "format": "int32" },
          "limit": { "type": "integer", "format": "int32" },
          "totalElements": { "type": "integer", "format": "int64" },
          "totalPages": { "type": "integer", "format": "int32" },
          "hasNext": { "type": "boolean" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string", "nullable": true }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "required": ["code", "errors", "message"],
        "properties": {
          "message": { "type": "string" },
          "code": { "type": "string" },
          "errors": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
