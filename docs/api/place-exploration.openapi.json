{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition - place exploration contract",
    "version": "v0"
  },
  "x-source": {
    "location": "http://54.116.166.107:8080/v3/api-docs",
    "sha256": "44876ca5f32736fa9dd0bebf6c67fd47f4674a6b9fd232ff975fa78cae30d31c"
  },
  "paths": {
    "/places/map": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "지도 viewport 장소 조회",
        "description": "지도 경계와 zoom에 따라 장소 cluster 또는 marker를 조회합니다.",
        "operationId": "mapViewport",
        "parameters": [
          {
            "name": "west",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "south",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "format": "double"
            }
          },
          {
            "name": "zoom",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MapViewportResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/{placeId}/card": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "관광객용 장소 카드 조회",
        "description": "관광객의 장소 탐색과 방문 결정을 위한 요약 정보를 조회합니다.",
        "operationId": "getTouristPlaceCard",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "장소 카드 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TouristPlaceCardResponse"
                }
              }
            }
          },
          "404": {
            "description": "공개 중인 장소를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/{placeId}/visit-decision": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "관광객용 장소 방문 결정 정보 조회",
        "description": "현재 운영 상태, 공지, 진행 이벤트, 예약 가능 시간과 발급 가능한 혜택을 한 번에 조회합니다.",
        "operationId": "getPlaceVisitDecision",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "description": "장소 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "방문 결정 정보 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceVisitDecisionResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않은 토큰",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "공개 중인 장소를 찾을 수 없음",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/{placeId}/operating-notices": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "장소 활성 운영 상태 공지 조회",
        "description": "현재 영업시간 기준 운영 여부와 활성 운영 상태 공지를 조회합니다.",
        "operationId": "listOperatingNotices",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "description": "장소 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceOperatingNoticeListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/{id}/media/verification": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "장소 검증용 미디어 조회",
        "description": "장소 소유자가 검증 출처로 기록된 미디어를 조회합니다.",
        "operationId": "getVerificationMedia",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "장소 ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "검증용 미디어 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceMediaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/places/recommendations/{requestId}/explanation": {
      "get": {
        "tags": [
          "App Place"
        ],
        "summary": "추천 설명 조회",
        "description": "사용자가 본인 추천 응답 requestId의 후보 source, score, ranking 정보를 조회합니다.",
        "operationId": "getRecommendationExplanation",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "description": "추천 응답 requestId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "9f7263d5-65f1-4834-9ca3-86ad2fc4e7d0"
          }
        ],
        "responses": {
          "200": {
            "description": "추천 설명 조회 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceRecommendationExplanationResponse"
                }
              }
            }
          },
          "404": {
            "description": "추천 설명 정보를 찾을 수 없음",
            "content": {
              "*/*": {
                "example": {
                  "message": "추천 설명 정보를 찾을 수 없습니다.",
                  "code": "RECOMMENDATION_EXPLANATION_NOT_FOUND"
                }
              }
            }
          }
        }
      }
    },
    "/places/{placeId}/map-link-conversions": {
      "post": {
        "tags": [
          "map-link-conversion-controller"
        ],
        "operationId": "record",
        "parameters": [
          {
            "name": "placeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MapLinkConversionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AvailabilityResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "productId": {
            "type": "integer",
            "format": "int64"
          },
          "productType": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TICKET",
              "CLASS"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalCapacity": {
            "type": "integer",
            "format": "int32"
          },
          "remainingCapacity": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "에러 코드",
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "MapClusterItem": {
        "type": "object",
