      "PlaceOperatingNoticeListResponse": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "currentlyOperating": {
            "type": "boolean"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceOperatingNoticeResponse"
            }
          }
        },
        "description": "상점 운영 상태 공지 목록 응답"
      },
      "PlaceOperatingNoticeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
