      },
      "PlaceOperatingExceptionResponse": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-08-15"
          },
          "closed": {
            "type": "boolean",
            "description": "true이면 종일 휴무이며 hours는 비어 있습니다."
