              "DIRECTIONS",
              "EXTERNAL_MAP"
            ]
          },
          "provider": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "MapMarkerItem": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "imageUrl": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "photoCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MapViewportResponse": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "zoom": {
            "type": "integer",
            "format": "int32"
          },
          "clusters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MapClusterItem"
            }
          },
          "markers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MapMarkerItem"
            }
          },
