          },
          "touristSummary": {
            "type": "string",
            "nullable": true
          },
          "touristCategories": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "K_POP",
                "BEAUTY",
                "FASHION",
                "CAFE",
                "FOOD",
                "POP_UP",
                "EXHIBITION",
                "NIGHTLIFE",
                "OTHER"
              ]
            }
          },
          "primaryInformationSource": {
            "type": "string",
            "enum": [
              "LEGACY",
              "KAKAO",
              "MERCHANT_OWNER",
              "ADMIN",
              "USER_REPORT",
              "SYSTEM"
            ]
          },
          "informationVerificationStatus": {
            "type": "string",
            "enum": [
              "UNVERIFIED",
              "SOURCE_CONFIRMED",
              "OWNER_SUBMITTED",
              "ADMIN_VERIFIED",
              "REJECTED",
              "DISPUTED",
              "EXPIRED"
            ]
          },
          "informationVerifiedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "informationEvidenceUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "verifiedEvidenceCount": {
            "type": "integer",
