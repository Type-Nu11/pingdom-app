            "type": "integer",
            "format": "int64"
          },
          "businessName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "contactEmail": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          }
        },
        "description": "장소에 연결된 Merchant Owner 공개 프로필",
