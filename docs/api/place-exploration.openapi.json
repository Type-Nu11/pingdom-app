      },
      "OfferPageResponse": {
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OfferResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "limit": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNext": {
            "type": "boolean"
          }
        }
      },
      "OfferResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1
          },
          "placeId": {
            "type": "integer",
            "format": "int64",
            "example": 10
          },
          "title": {
            "type": "string",
            "example": "관광객 웰컴 음료"
          },
          "description": {
            "type": "string"
          },
          "benefitDescription": {
            "type": "string",
            "example": "음료 1잔 무료"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "CLOSED"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "totalQuantity": {
            "type": "integer",
            "description": "LIMITED 재고의 총 발급 수량. UNLIMITED이면 null",
            "format": "int32",
            "nullable": true
          },
          "issuedQuantity": {
            "type": "integer",
            "format": "int32"
          },
          "remainingQuantity": {
            "type": "integer",
            "description": "남은 발급 수량. UNLIMITED이면 null",
            "format": "int32",
            "nullable": true
          },
          "couponValidityDays": {
            "type": "integer",
            "format": "int32"
          },
          "eligibilityPolicy": {
            "type": "string",
            "enum": [
              "ACTIVE_TRAVEL_SCHEDULE",
              "PUBLIC"
            ]
          },
          "inventoryPolicy": {
            "type": "string",
            "enum": [
              "LIMITED",
              "UNLIMITED"
            ]
          },
          "expiryPolicy": {
            "type": "string",
            "enum": [
              "ISSUE_PLUS_DAYS_CAPPED_BY_OFFER_END",
              "ISSUE_PLUS_DAYS",
              "OFFER_END"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PlaceDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "englishName": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string"
          },
          "roadAddress": {
            "type": "string",
            "nullable": true
          },
          "jibunAddress": {
            "type": "string",
            "nullable": true
          },
          "postalCode": {
            "type": "string",
            "nullable": true
          },
          "geocodingSource": {
            "type": "string",
