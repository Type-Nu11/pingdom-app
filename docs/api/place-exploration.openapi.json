            "format": "int32",
            "example": 3
          },
          "lastVerifiedAt": {
            "type": "string",
            "description": "가장 최근 검증이 완료된 시각",
            "format": "date-time",
            "nullable": true
          },
          "lastVerifiedSourceType": {
            "type": "string",
            "description": "가장 최근 검증 근거의 출처",
            "nullable": true,
            "enum": [
              "LEGACY",
              "KAKAO",
              "MERCHANT_OWNER",
              "ADMIN",
              "USER_REPORT",
              "SYSTEM"
            ]
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          },
          "registrant": {
            "type": "string"
          },
          "merchantOwner": {
            "$ref": "#/components/schemas/MerchantOwnerPublicResponse"
          }
        },
