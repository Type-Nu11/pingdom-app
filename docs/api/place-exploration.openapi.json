      "PlaceMediaResponse": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "integer",
            "format": "int64"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceMediaItem"
