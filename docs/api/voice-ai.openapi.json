  "paths": {
    "/voice-ai/sessions": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 세션 생성",
        "description": "JWT 사용자 소유 세션을 생성합니다. 세션은 5분 뒤 만료됩니다.",
        "operationId": "create",
        "responses": {
          "201": {
            "description": "세션 생성 성공",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceAiSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/voice-ai/sessions/{sessionId}/refresh": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 세션 갱신",
        "description": "활성 세션의 만료 시각을 현재 시점에서 5분으로 갱신합니다.",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceAiSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "SESSION_FORBIDDEN: 다른 사용자 세션. ACCESS_DENIED: 공통 접근 거부",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "SESSION_NOT_FOUND: 존재하지 않는 세션",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "SESSION_EXPIRED: 만료 또는 종료된 세션은 갱신할 수 없습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/voice-ai/sessions/{sessionId}/messages": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 메시지 전송",
        "description": "ProviderEnvelope v1 최종 JSON 1개만 반환합니다. SSE/WebSocket/reconnect cursor는 지원하지 않습니다.\n최종 envelope는 UTF-8 16 KiB 이하이며 id는 requestId와 정확히 일치합니다.\n활성 세션 내 requestId를 대소문자 구분하여 비교합니다. 동일 ID·동일 text(UTF-8 SHA-256)는 저장된 결과를\n반환하고 다른 text는 409 REPLAY_CONFLICT입니다. 세션 단위로 전송·갱신·종료를 직렬화하므로 진행 중 재요청은\n선행 트랜잭션 완료 후 재검사합니다. 실패하여 결과가 저장되지 않았다면 재시도에서 provider를 다시 호출합니다.\n결과는 세션이 활성인 동안 재사용하며 refresh는 이 기간을 연장합니다. 만료·종료 후에는 replay도 410입니다.\n현재 저장 데이터의 자동 삭제 기간은 설정되어 있지 않습니다. 앱의 epoch/generation 및 256개 ledger는 앱 소유입니다.\n앱의 30초 deadline이나 연결 종료는 서버/provider 취소를 보장하지 않습니다. 서버 처리가 커밋되었다면\n동일 ID/text 재시도로 결과를 회수할 수 있습니다. DELETE는 진행 중 전송 완료 후 세션을 종료하며 호출을 취소하지 않습니다.\nprovider 연결/read timeout은 gemini 설정(기본 2초/5초)이며 서버 전체 deadline을 의미하지 않습니다.\n",
        "operationId": "send",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceAiMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "ProviderEnvelope v1 최종 JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderEnvelopeV1"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED: text/requestId 검증 실패(errors 포함). INVALID_REQUEST_BODY: JSON 파싱 실패.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "SESSION_FORBIDDEN: 다른 사용자 세션. ACCESS_DENIED: 공통 접근 거부",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "SESSION_NOT_FOUND: 존재하지 않는 세션",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "REPLAY_CONFLICT: 동일 세션·requestId에 다른 text를 보냈습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "SESSION_EXPIRED: 만료 또는 종료된 세션. replay도 반환하지 않습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMIT_EXCEEDED: controller 진입 시 IP 기준 Redis 제한. consultations/intro와 공유하며 기본 1분 10회(설정 가능). replay도 제한에 포함됩니다. Retry-After는 제공하지 않습니다. 즉시 반복하지 말고 backoff 후 동일 requestId/text로 재시도합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "PROVIDER_UNAVAILABLE: provider timeout·일반 장애·비활성 설정. PROVIDER_RESPONSE_INVALID: schema 위반·16 KiB 초과. timeout 전용 code는 없습니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "RATE_LIMIT_UNAVAILABLE: fail-open=false일 때 제한 저장소 장애. backoff 후 재시도합니다.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
