{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "x-source": {
    "location": "https://www.typenull.xyz/v3/api-docs",
    "sha256": "10cac55c1e57db3a20c8b36b2b4728bf05b20a3db501cbf23e243bdeecaaa2fc"
  },
  "paths": {
    "/voice-ai/sessions": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 세션 생성",
        "description": "JWT 사용자 소유 세션을 생성합니다. 세션은 5분 뒤 만료됩니다.",
        "operationId": "create",
        "responses": {
          "201": {
            "description": "세션 생성 성공",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceAiSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/voice-ai/sessions/{sessionId}/refresh": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 세션 갱신",
        "description": "활성 세션의 만료 시각을 현재 시점에서 5분으로 갱신합니다.",
        "operationId": "refresh",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/VoiceAiSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/voice-ai/sessions/{sessionId}/messages": {
      "post": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 메시지 전송",
        "description": "ProviderEnvelope v1 최종 JSON만 반환합니다. requestId는 앱 재전송 시 동일하게 유지해야 합니다.",
        "operationId": "send",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceAiMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "최종 envelope 반환",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/JsonNode"
                }
              }
            }
          },
          "400": {
            "description": "요청 값 검증 실패 (VALIDATION_FAILED) 또는 도메인 입력 정책 위반",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ErrorResponse"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationErrorResponse"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "만료 또는 종료된 세션",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "provider 장애 또는 계약 위반",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/voice-ai/sessions/{sessionId}": {
      "delete": {
        "tags": [
          "Voice AI"
        ],
        "summary": "음성 AI 세션 종료",
        "description": "동일 세션의 반복 종료 요청은 성공으로 처리됩니다.",
        "operationId": "close_2",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "유효하지 않거나 만료된 Bearer JWT (INVALID_TOKEN 또는 EXPIRED_TOKEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "권한이 없거나 접근이 거부됨 (ACCESS_DENIED 또는 도메인 권한 오류)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "VoiceAiSessionResponse": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "에러 메시지",
            "example": "유효하지 않은 토큰입니다."
          },
          "code": {
            "type": "string",
            "description": "도메인 에러 코드. 일부 공통 검증 오류에서는 제공되지 않을 수 있습니다.",
            "nullable": true,
            "example": "INVALID_TOKEN"
          }
        },
        "description": "에러 응답"
      },
      "VoiceAiMessageRequest": {
        "required": [
          "requestId",
          "text"
        ],
        "type": "object",
        "properties": {
          "text": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string"
          },
          "requestId": {
            "maxLength": 128,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          }
        }
      },
      "JsonNode": {
        "type": "object"
      },
      "ValidationErrorResponse": {
        "required": [
          "code",
          "errors",
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "필드 검증 오류 응답"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
