# V2 runtime environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Public values bundled into the mobile application
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_API_MODE=real
# Mock only: success | empty | forbidden | expired | network-error
EXPO_PUBLIC_MOCK_SCENARIO=success
EXPO_PUBLIC_MOCK_LATENCY_MS=250
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# Defaults to true only for development + real API. Set false to verify the disabled UI.
EXPO_PUBLIC_ENABLE_PLACE_LIST=true
